# NEXUS environment configuration
# Copy to .env and fill in real values.

# LLM
OPENAI_API_KEY=your-openai-key
NEXUS_LLM_MODEL=gpt-4o
NEXUS_EMBEDDING_MODEL=text-embedding-3-large

# Offline LLM (Ollama / LM Studio) - run NEXUS fully offline against a local,
# OpenAI-compatible server. Same adapters, purely an env-var switch.
# Uncomment + adjust to use a local model instead of real OpenAI:
#
# Ollama (default port 11434, models served under /v1):
#   NEXUS_LLM_BASE_URL=http://localhost:11434/v1
#   NEXUS_LLM_MODEL=llama3:8b
#   NEXUS_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   NEXUS_EMBEDDING_MODEL=nomic-embed-text
#   NEXUS_EMBEDDING_DIMENSION=768
#
# LM Studio (default port 1234):
#   NEXUS_LLM_BASE_URL=http://localhost:1234/v1
#   NEXUS_LLM_MODEL=local-model-name
#
# Local servers don't check OPENAI_API_KEY, so it can stay blank.
# NOTE: structured JSON output (response_format=json_object) used by entity
# extraction isn't reliably supported by every local model - a known
# limitation, not worked around.

# Hybrid split - two LLM slots in one deployment:
#   NEXUS_LLM_*            = the interactive path (live chat/ReAct, tool-gen,
#                            swarms) - use a fast hosted or strong model.
#   NEXUS_BACKGROUND_LLM_* = background loops (subconscious synthesis,
#                            nightly dreaming, autonomy) - use a cheap/local
#                            model to save quota.
# Example: Groq (fast hosted) for chat, Ollama (local) for background loops:
#   NEXUS_LLM_BASE_URL=https://api.groq.com/openai/v1
#   NEXUS_LLM_MODEL=llama-3.3-70b-versatile
#   OPENAI_API_KEY=your-groq-api-key
#   NEXUS_BACKGROUND_LLM_BASE_URL=http://localhost:11434/v1
#   NEXUS_BACKGROUND_LLM_MODEL=llama3:8b
#   # optional separate key for the background provider; defaults to OPENAI_API_KEY
#   NEXUS_BACKGROUND_LLM_API_KEY=
# Note: Groq has no embeddings endpoint - keep NEXUS_EMBEDDING_BASE_URL on
# Ollama (nomic-embed-text) or real OpenAI. Free tier is rate-limited per
# model (e.g. llama-3.3-70b-versatile at 30 req/min), which is exactly why
# the always-on background loops should stay on the local model.

# Speech (multi-modal P3)
NEXUS_STT_MODEL=whisper-1
NEXUS_TTS_MODEL=tts-1
NEXUS_TTS_VOICE=alloy

# Redis (event bus + short-term memory)
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j (synaptic graph memory)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Qdrant (vector memory)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SHARD_NUMBER=1
QDRANT_REPLICATION_FACTOR=1

# API
# Comma-separated list of allowed browser origins (CORS)
NEXUS_CORS_ORIGINS=http://localhost:3000

# API keys: JSON object of {key: {user_id, tenant_id, role}}
# Roles: admin, user. Requests without a valid Bearer token are rejected.
# Example: {"sk-test": {"user_id": "u1", "tenant_id": "t1", "role": "admin"}}
NEXUS_API_KEYS={}

# Local UI auth: with NEXUS_API_KEYS empty, "auto" (default) lets the shipped
# UI call /v1/* from localhost WITHOUT a bearer token (the whole point of a
# zero-config LM Studio box). The moment any key is configured, or the client
# is not loopback, every endpoint stays fail-closed. Set "false" to always
# require a bearer token, "true" to bypass for any client (dev only).
NEXUS_LOCAL_UI_AUTH=auto

# Comma-separated list of tenant ids allowed to create their own collections.
NEXUS_TENANTS=

# Code execution sandbox: subprocess (default, dev only) or docker (hardened)
NEXUS_SANDBOX_BACKEND=subprocess

# Rate limiting (per identity, sliding window)
NEXUS_CHAT_RATE_LIMIT=60
NEXUS_TOOL_GEN_RATE_LIMIT=20
NEXUS_RATE_LIMIT_WINDOW_SECONDS=60
# Deny requests instead of skipping limits when Redis is unavailable (true = fail-closed)
NEXUS_RATE_LIMIT_FAIL_CLOSED=false

# Observability
NEXUS_JSON_LOGS=true

# Autonomous goals (P2)
# Max autonomous steps allowed per tenant per hour (0 = unlimited)
NEXUS_AUTONOMY_HOURLY_BUDGET=0
# Default step budget when a goal is created without one
NEXUS_AUTONOMY_DEFAULT_BUDGET=20
# Comma-separated autonomous actions exempt from human approval
# (tool_selfheal = regenerate failing tools automatically)
NEXUS_AUTONOMY_ALLOWLIST=tool_selfheal
# Max concurrent active goals a tenant can drive
NEXUS_GOALS_MAX_ACTIVE=10

# Swarm (multi-agent P4)
# Max workers a swarm can fan out to
NEXUS_SWARM_MAX_WORKERS=5

# Deployers: local | railway | vercel
NEXUS_DEPLOY_PLATFORM=local

# Secret backend: env | json | chain (json/chained look for a JSON file)
NEXUS_SECRET_BACKEND=env
# NEXUS_SECRETS_FILE=C:\Users\Ashut\NEXUS\.secrets.json

# Railway (NEXUS_DEPLOY_PLATFORM=railway)
# RAILWAY_TOKEN=your-railway-graphql-token
# RAILWAY_PROJECT_ID=your-railway-project-id

# Vercel (NEXUS_DEPLOY_PLATFORM=vercel)
# VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=your-vercel-team-id

# Celery (subconscious workers)
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2

# Dreaming schedule (cron, UTC)
DREAM_HOUR=3
