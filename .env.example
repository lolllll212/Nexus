# NEXUS environment configuration
# Copy to .env and fill in real values.

# LLM
OPENAI_API_KEY=your-openai-key
NEXUS_LLM_MODEL=gpt-4o
NEXUS_EMBEDDING_MODEL=text-embedding-3-large

# Speech (multi-modal P3)
NEXUS_STT_MODEL=whisper-1
NEXUS_TTS_MODEL=tts-1
NEXUS_TTS_VOICE=alloy

# Redis (event bus + short-term memory)
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j (synaptic graph memory)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Qdrant (vector memory)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SHARD_NUMBER=1
QDRANT_REPLICATION_FACTOR=1

# API
# Comma-separated list of allowed browser origins (CORS)
NEXUS_CORS_ORIGINS=http://localhost:3000

# API keys: JSON object of {key: {user_id, tenant_id, role}}
# Roles: admin, user. Requests without a valid Bearer token are rejected.
# Example: {"sk-test": {"user_id": "u1", "tenant_id": "t1", "role": "admin"}}
NEXUS_API_KEYS={}

# Comma-separated list of tenant ids allowed to create their own collections.
NEXUS_TENANTS=

# Rate limiting (per identity, sliding window)
NEXUS_CHAT_RATE_LIMIT=60
NEXUS_TOOL_GEN_RATE_LIMIT=20
NEXUS_RATE_LIMIT_WINDOW_SECONDS=60

# Observability
NEXUS_JSON_LOGS=true

# Autonomous goals (P2)
# Max autonomous steps allowed per tenant per hour (0 = unlimited)
NEXUS_AUTONOMY_HOURLY_BUDGET=0
# Default step budget when a goal is created without one
NEXUS_AUTONOMY_DEFAULT_BUDGET=20
# Comma-separated autonomous actions exempt from human approval
# (tool_selfheal = regenerate failing tools automatically)
NEXUS_AUTONOMY_ALLOWLIST=tool_selfheal
# Max concurrent active goals a tenant can drive
NEXUS_GOALS_MAX_ACTIVE=10

# Swarm (multi-agent P4)
# Max workers a swarm can fan out to
NEXUS_SWARM_MAX_WORKERS=5

# Deployers: local | railway | vercel
NEXUS_DEPLOY_PLATFORM=local

# Secret backend: env | json | chain (json/chained look for a JSON file)
NEXUS_SECRET_BACKEND=env
# NEXUS_SECRETS_FILE=C:\Users\Ashut\NEXUS\.secrets.json

# Railway (NEXUS_DEPLOY_PLATFORM=railway)
# RAILWAY_TOKEN=your-railway-graphql-token
# RAILWAY_PROJECT_ID=your-railway-project-id

# Vercel (NEXUS_DEPLOY_PLATFORM=vercel)
# VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=your-vercel-team-id

# Celery (subconscious workers)
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2

# Dreaming schedule (cron, UTC)
DREAM_HOUR=3
