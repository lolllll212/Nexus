{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/AGENT_COORDINATION.md"],
  "model": "google/gemini-3-pro-high",
  "small_model": "google/gemini-3-flash",
  "permission": {
    "bash": {
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git commit*": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "black*": "allow",
      "mypy*": "allow",
      "rm *": "deny",
      "git push*": "ask",
      "*": "ask"
    }
  }
}