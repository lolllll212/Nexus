# NEXUS environment configuration — LM Studio local models

# ── LLM (interactive chat) ──────────────────────────────────────────────
NEXUS_LLM_BASE_URL=http://localhost:1234/v1
NEXUS_LLM_MODEL=qwen/qwen3.5-9b
NEXUS_LLM_MAX_TOKENS=35000
OPENAI_API_KEY=local-no-key

# ── Background LLM (dreaming, synthesis, autonomy) ──────────────────────
NEXUS_BACKGROUND_LLM_BASE_URL=http://localhost:1234/v1
NEXUS_BACKGROUND_LLM_MODEL=qwen2.5-coder-7b-instruct

# ── Embeddings (local via LM Studio) ────────────────────────────────────
NEXUS_EMBEDDING_BASE_URL=http://localhost:1234/v1
NEXUS_EMBEDDING_MODEL=all-MiniLM-L6-v2
NEXUS_EMBEDDING_DIMENSION=384

# ── Redis (event bus + short-term memory) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Neo4j (synaptic graph memory) ──────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Qdrant (vector memory) ─────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SHARD_NUMBER=1
QDRANT_REPLICATION_FACTOR=1

# ── API ─────────────────────────────────────────────────────────────────
NEXUS_CORS_ORIGINS=http://localhost:3000
NEXUS_API_KEYS={}

# ── Observability ───────────────────────────────────────────────────────
NEXUS_JSON_LOGS=true

# ── Celery (subconscious workers) ───────────────────────────────────────
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2

# ── Dreaming schedule ───────────────────────────────────────────────────
DREAM_HOUR=3

# ── Plugins ─────────────────────────────────────────────────────────────
NEXUS_PLUGINS_DIR=plugins
