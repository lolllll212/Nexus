{
  "system": "N.E.X.U.S",
  "fullName": "Neural EXpansion Unified System",
  "version": "0.1.0",
  "tagline": "a new kind of brain — cosmos joint",
  "backend": {
    "apiBase": "http://127.0.0.1:8000",
    "endpoints": {
      "chat": "/v1/chat",
      "chatStream": "/v1/chat/stream",
      "graph": "/api/graph",
      "graphLegacy": "/v1/memory/graph",
      "memorySearch": "/v1/memory/search",
      "concepts": "/v1/memory/concepts",
      "dream": "/v1/system/dream",
      "swarms": "/v1/swarms",
      "health": "/v1/system/health",
      "metrics": "/metrics"
    },
    "auth": {
      "type": "bearer",
      "header": "Authorization: Bearer <NEXUS_API_KEY>",
      "env": "NEXUS_API_KEYS"
    }
  },
  "integrations": {
    "gmail": {
      "enabled": false,
      "provider": "google",
      "oauth": {
        "clientIdEnv": "GMAIL_CLIENT_ID",
        "clientSecretEnv": "GMAIL_CLIENT_SECRET",
        "redirectUri": "http://127.0.0.1:8000/oauth/gmail/callback",
        "scopes": ["https://www.googleapis.com/auth/gmail.readonly", "https://www.googleapis.com/auth/gmail.send"]
      },
      "pollIntervalMs": 60000,
      "cosmosNode": "gmail"
    },
    "drive": {
      "enabled": false,
      "provider": "google",
      "oauth": {
        "clientIdEnv": "DRIVE_CLIENT_ID",
        "clientSecretEnv": "DRIVE_CLIENT_SECRET",
        "redirectUri": "http://127.0.0.1:8000/oauth/drive/callback",
        "scopes": ["https://www.googleapis.com/auth/drive.readonly"]
      },
      "syncFolder": "NEXUS/cosmos",
      "cosmosNode": "drive"
    },
    "github": {
      "enabled": false,
      "provider": "github",
      "oauth": {
        "clientIdEnv": "GITHUB_CLIENT_ID",
        "clientSecretEnv": "GITHUB_CLIENT_SECRET",
        "redirectUri": "http://127.0.0.1:8000/oauth/github/callback",
        "scopes": ["repo", "read:user"]
      },
      "webhookSecretEnv": "GITHUB_WEBHOOK_SECRET",
      "cosmosNode": "github"
    },
    "whatsapp": {
      "enabled": false,
      "provider": "meta",
      "oauth": {
        "clientIdEnv": "WHATSAPP_TOKEN",
        "apiVersion": "v20.0"
      },
      "note": "WhatsApp Cloud API bridge — send/read messages as memories",
      "cosmosNode": "whatsapp"
    },
    "telegram": {
      "enabled": false,
      "provider": "telegram",
      "oauth": {
        "clientIdEnv": "TELEGRAM_BOT_TOKEN"
      },
      "note": "Telegram bot bridge — chat with NEXUS from Telegram",
      "cosmosNode": "telegram"
    },
    "threads": {
      "enabled": false,
      "provider": "meta",
      "oauth": {
        "clientIdEnv": "THREADS_TOKEN",
        "apiVersion": "v1.0"
      },
      "note": "Threads bridge — auto-post drafted updates",
      "cosmosNode": "threads"
    },
    "social": {
      "enabled": false,
      "provider": "nexus",
      "oauth": {},
      "note": "Social media automation — swarm-drafted cross-posts (RUN = generate)",
      "cosmosNode": "social"
    },
    "youtube": {
      "enabled": false,
      "provider": "google",
      "oauth": {
        "clientIdEnv": "YOUTUBE_CLIENT_ID",
        "clientSecretEnv": "YOUTUBE_CLIENT_SECRET"
      },
      "note": "YouTube bridge — draft titles/descriptions from memory",
      "cosmosNode": "youtube"
    }
  },
  "cosmos": {
    "description": "Cosmos-like joint structure — every subsystem is a node, every integration is an edge. Rendered as 3D force graph in #3d-graph.",
    "joints": "fully-meshed: nexus_core is the gravity well; all satellites orbit and link to each other (mesh), not just hub-spoke",
    "nodes": [
      { "id": "N.E.X.U.S", "group": "core", "val": 18, "color": "#ffcf7d", "desc": "Neural EXpansion Unified System — conscious + subconscious loops" },
      { "id": "H.O.L.O", "group": "ui", "val": 12, "color": "#7dffd9", "desc": "Hand-gesture deck / 3D stage" },
      { "id": "Dinosaur", "group": "Dinosaur", "val": 10, "color": "#8ecae6", "glb": "/props/triceratops.glb", "desc": "Paleo concept — triceratops" },
      { "id": "Space", "group": "Space", "val": 10, "color": "#ffd166", "glb": "/props/apollo-11-module.glb", "desc": "Apollo 11 module" },
      { "id": "memory", "group": "memory", "val": 8, "color": "#a9ffe6", "desc": "Qdrant + Neo4j + Redis" },
      { "id": "concept", "group": "concept", "val": 8, "color": "#c9ffe6", "desc": "Synaptic graph (Neo4j)" },
      { "id": "swarm", "group": "swarm", "val": 7, "color": "#d9fff2", "desc": "Multi-agent orchestration" },
      { "id": "dream", "group": "subconscious", "val": 7, "color": "#ffe9c4", "desc": "Dreaming pipeline" },
      { "id": "gmail", "group": "integration", "val": 6, "color": "#ea4335", "desc": "Gmail bridge — ingest threads as memories" },
      { "id": "drive", "group": "integration", "val": 6, "color": "#34a853", "desc": "Drive bridge — markdown / docs as knowledge" },
      { "id": "github", "group": "integration", "val": 6, "color": "#4078c0", "desc": "GitHub bridge — repos/issues as concepts" },
      { "id": "whatsapp", "group": "integration", "val": 6, "color": "#25D366", "desc": "WhatsApp bridge — message ingest + sends (flag stub)" },
      { "id": "telegram", "group": "integration", "val": 6, "color": "#229ED9", "desc": "Telegram bot bridge — chat with NEXUS anywhere (flag stub)" },
      { "id": "threads", "group": "integration", "val": 6, "color": "#d9d9d9", "desc": "Threads bridge — auto-post drafted updates (flag stub)" },
      { "id": "social", "group": "integration", "val": 7, "color": "#ff7a59", "desc": "Social media automation — swarm-drafted cross-posts. RUN drafts one now." },
      { "id": "youtube", "group": "integration", "val": 6, "color": "#ff4e45", "desc": "YouTube bridge — titles/descriptions from memory (flag stub)" },
      { "id": "tools", "group": "self-evolution", "val": 7, "color": "#9dffe4", "desc": "Generated tools" }
    ],
    "links": [
      { "source": "N.E.X.U.S", "target": "H.O.L.O", "weight": 1.0 },
      { "source": "N.E.X.U.S", "target": "memory", "weight": 0.9 },
      { "source": "N.E.X.U.S", "target": "concept", "weight": 0.9 },
      { "source": "N.E.X.U.S", "target": "swarm", "weight": 0.8 },
