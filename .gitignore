# Vendored third-party tools: commit source, not build/install outputs
vendor/rea/node_modules/
vendor/rea/dist/
vendor/rea/.cache/
vendor/rea/.turbo/
vendor/rea/.stryker-tmp/
vendor/rea/test-results.xml
# REA Windows native addon is a packaged binary - restore it from the
# rea-agents@<version> tarball (see docs/rea.md), do not commit it.
vendor/rea/native/windows/build/*.node

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Temp files
_test_*.py
*.tmp
data/coding_examples_*.json

# Local chat history contains private conversation transcripts.
data/chat_history.json
data/chat_history.json.tmp
py_deps/
web_vendor/

# opencode sessions
.opencode/sessions/
.opencode/storage/
.opencode/tui.json

# Agent state & queues (local only)
nexus_state.json
agent_activity.jsonl
vscode-nexus-queue/
.agents/
.claude/

# Multi-agent coordination runtime state (shared via main worktree, never committed)
agent_memory.json
consensus_state.json
planning_state.json
nexus_crdt.json
token_budget_ledger.json
board.txt
inbox.txt
status.txt

# Runtime LLM selection (provider+model only; keys stay in memory/env)
backend/llm_state.json

# RL training reward store (accumulated scored pairs)
backend/rl_training_state.json

# Frontend build output (web/ vite -> frontend/dist) - built by CI/Vercel, never committed.
# The vanilla cosmos pages (frontend/*.html) intentionally stay buildless; a Vite
# multi-page migration was evaluated and deferred (see repo upgrade notes).
frontend/dist/

# Cosmos MPA pipeline (frontend/)
frontend/node_modules/
frontend/dist-cosmos/
