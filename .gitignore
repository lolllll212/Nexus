# ── Secrets & local config ────────────────────────────────────────────
# `.env` holds real credentials — never commit it. `.env.example` is the template.
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
*.whl

# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/

# ── Testing / tooling caches ──────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
*.cover
htmlcov/
coverage.xml

# ── Celery / workers ──────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log

# ── Editors & OS ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Temp files ────────────────────────────────────────────────────────
_test_*.py
*.tmp
